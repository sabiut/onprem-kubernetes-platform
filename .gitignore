# Secrets and credentials (generated by Terraform and Ansible)
.keys/
kubeconfig/
*.pem
*.key
id_ed25519*
id_rsa*
.env
.env.*
.vault_pass*

# Terraform: state holds the private SSH key, never commit it
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible: inventory is generated by Terraform
ansible/inventories/local/hosts.yml
*.retry
.ansible/

# Helm: packaged charts and downloaded dependencies
helm/charts/*/charts/
*.tgz

# Personal study notes and generated documents, not part of the project
tmp/
output/
*.pdf
GUIDE.html

# Disk images
*.qcow2
*.iso
*.img

# Editor, OS and tool files
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.pyc
.claude/
.codex/
*.bak
*.log
